  "pain_points": [
    "塑料卫星箱谐振 + 小房间边界反射 → 160-315Hz 中低频染声，掩蔽对白（用户最高频槽点）",
    "中置双 2\" 全频灵敏度受限 → 2-3kHz 对白可懂度不足（人声被背景声淹没）",
    "无源 6\" 炮 40-50Hz 以下急剧滚降、缺乏有源炮冲击力（EQ 强推必打底）",
    "环绕箱无独立高音 → 后场高频偏暗；1000W 为 PMPO 营销口径，动态余量实为入门 HTiB 水平"
  ],
  "directions": [
    "220Hz 收敛 -2dB 清中低频染声、解除对白掩蔽（负增益同时降低无源炮冲程）",
    "2800Hz +2dB 对白可懂度核心补偿（台词口型清晰化）",
    "90Hz 低架 +2dB 温和补量（转角置于滚降区上方，不触碰 40-50Hz 物理边界）",
    "9kHz 高架 +1.5dB 补 ¾\" 高音空气感（环绕暗区全局保守处理，不分离声道）",
    "音源设备开 Dolby Digital 位流 + 避免与机内 DSP 叠加（双 EQ 失真）"
  ],
  "target": "对白优先：解除中低频对白掩蔽、抬升对白可懂度，温和补无源炮量感与 ¾\" 高音空气感（不触碰物理滚降区）",
  "metrics": "160-315Hz 中低频 -2dB 级收敛；2.5-3.15kHz 对白区 +1.8~2dB；60-100Hz 低架 +2dB（40-50Hz 滚降段不强推）；9kHz 高架 +1.5dB；全部 ≤2dB 守无源炮与塑料卫星箱裕量",
  "advice": "顺序：先 220Hz 收敛→听 10 分钟→再 2.8kHz→最后 90Hz/9kHz；音源设备须开 Dolby Digital 位流输出（否则中置偏弱、人声从全部音箱一起出）；蓝牙播放后置无声时按遥控器 3D Sound 键；避免与机内 DSP（3D Sound/夜间模式）叠加造成双 EQ 失真。",
